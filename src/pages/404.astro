---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found — Devina Azaria"
  description="The requested page is not part of the current Devina Azaria portfolio."
>
  <section class="shell section page-intro">
    <div class="eyebrow">404</div>
    <h1>Page not found.</h1>
    <p class="lead">
      This address is not part of the current portfolio. Older public paths are
      preserved through the archive when available.
    </p>
    <div class="actions">
      <a class="button primary" href="/">Back to home</a>
      <a class="button secondary" href="https://archive.devina.id/">Open archive ↗</a>
    </div>
  </section>
</BaseLayout>
