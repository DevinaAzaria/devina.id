---
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = [
  { number: '01', label: 'Astronomy · Learning Lab', title: 'Astronomy Lab', description: 'Ruang eksperimen untuk mengubah konsep astronomi menjadi latihan, observasi, simulasi, dan catatan belajar yang dapat diuji.', href: 'https://github.com/DevinaAzaria/astronomy-lab', link: 'Explore repository', featured: true },
  { number: '02', label: 'Engineering · Simulation', title: 'Flight Dynamics Lab', description: 'Eksplorasi awal tentang gaya, gerak, kestabilan, dan dinamika penerbangan sebagai jembatan menuju aerospace engineering.', href: 'https://github.com/DevinaAzaria/flight-dynamics-lab', link: 'View project' },
  { number: '03', label: 'Education · System', title: 'Olympiad Learning System', description: 'Sistem belajar terstruktur untuk membangun fondasi matematika, fisika, dan astronomi menuju kompetisi yang lebih serius.', href: 'https://ols.devina.id', link: 'Open OLS' },
];

const achievements = [
  { year: '2026', title: 'Wakil 3 Duta Budaya DI Yogyakarta', detail: 'Belajar membawa pengetahuan budaya, komunikasi, dan kepribadian ke ruang publik.' },
  { year: '2026', title: 'Juara 3 Festival Band Pelajar', detail: 'Berkarya dalam format band melalui disiplin latihan, kolaborasi, dan penampilan.' },
  { year: '2026', title: 'Divisi Kreatif MPK Padmanaba', detail: 'Mengembangkan gagasan dan eksekusi kreatif bersama organisasi siswa.' },
  { year: 'Next', title: 'Astronomy & Engineering', detail: 'Membangun fondasi OSN Astronomi dan portofolio menuju teknik mesin dan dirgantara.' },
];
---

<BaseLayout title="Devina Azaria — Science, Engineering, Music & Culture" description="Official personal hub of Devina Azaria: student projects in astronomy, engineering, music, culture, and leadership.">
  <section class="shell hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <div class="eyebrow">Student · Yogyakarta, Indonesia</div>
      <h1 id="hero-title">Curious by nature.<br/><span>Building with purpose.</span></h1>
      <p class="lead">Saya Devina Azaria—pelajar yang bertumbuh di persimpangan science, engineering, music, dan culture. Di sini, proses belajar tidak berhenti sebagai rencana; ia dibangun menjadi proyek, karya, dan rekam jejak.</p>
      <div class="actions"><a class="button" href="#projects">Explore selected work <span aria-hidden="true">↘</span></a><a class="button secondary" href="https://hq.devina.id">Visit DevinaHQ <span aria-hidden="true">↗</span></a></div>
    </div>
    <aside class="hero-orbit" aria-label="Current direction">
      <div class="orbit orbit-outer"></div><div class="orbit orbit-inner"></div>
      <div class="orbit-core"><span>Current<br/>Direction</span></div>
      <div class="orbit-label label-one">Astronomy</div><div class="orbit-label label-two">Engineering</div><div class="orbit-label label-three">Creative Practice</div>
    </aside>
  </section>

  <section class="signal-strip" aria-label="Areas of focus"><div class="shell signal-inner"><span>Science</span><i></i><span>Engineering</span><i></i><span>Music</span><i></i><span>Culture</span><i></i><span>Leadership</span></div></section>

  <section id="projects" class="shell section">
    <div class="section-heading"><div><div class="eyebrow">Selected Work</div><h2>Learning made visible.</h2></div><p>Proyek dipakai untuk mendokumentasikan pertanyaan, proses, pengujian, hasil, dan refleksi—bukan sekadar menyatakan minat.</p></div>
    <div class="project-grid">
      {projects.map((project) => (
        <article class:list={['project-card', { featured: project.featured }]}>
          <div class="project-top"><span>{project.number}</span><span>{project.label}</span></div>
          <div><h3>{project.title}</h3><p>{project.description}</p><a class="text-link" href={project.href}>{project.link} <span aria-hidden="true">↗</span></a></div>
        </article>
      ))}
    </div>
  </section>

  <section id="journey" class="journey-section"><div class="shell journey-layout">
    <div class="journey-intro"><div class="eyebrow">Academic Direction</div><h2>From foundations<br/>to flight.</h2><p>Target jangka panjangnya adalah engineering—khususnya mechanics dan aerospace. Jalurnya dibangun bertahap melalui matematika, fisika, astronomi, coding, eksperimen, dan dokumentasi.</p></div>
    <ol class="journey-steps">
      <li><span>01</span><div><strong>Strengthen the foundations</strong><p>Mathematics, physics, scientific reasoning, and communication.</p></div></li>
      <li><span>02</span><div><strong>Compete and investigate</strong><p>Olympiad astronomy, measurable questions, observation, and analysis.</p></div></li>
      <li><span>03</span><div><strong>Design and build</strong><p>Mechanics, simulation, prototypes, testing, and technical reflection.</p></div></li>
      <li><span>04</span><div><strong>Move toward aerospace</strong><p>A growing portfolio for university, scholarship, and real-world exploration.</p></div></li>
    </ol>
  </div></section>

  <section id="achievements" class="shell section">
    <div class="section-heading"><div><div class="eyebrow">Milestones · 2026</div><h2>Different stages, one practice.</h2></div><p>Setiap pencapaian melatih hal yang sama: persiapan, keberanian tampil, kerja bersama, dan kemauan memperbaiki diri.</p></div>
    <div class="achievement-list">{achievements.map((item) => (<article class="achievement-item"><span class="achievement-year">{item.year}</span><h3>{item.title}</h3><p>{item.detail}</p></article>))}</div>
  </section>

  <section id="beyond" class="shell section beyond-grid">
    <div class="beyond-statement"><div class="eyebrow">Beyond STEM</div><h2>Rhythm, language, and culture shape how I think.</h2></div>
    <div class="beyond-copy"><p>Drums, violin, guitar, vocals, macapat, geguritan, storytelling, dan seni tradisi bukan sisi yang terpisah dari science. Semuanya melatih kepekaan terhadap pola, ketekunan, komunikasi, dan kolaborasi.</p><a class="text-link" href="https://www.reiea.com">Discover the music ecosystem <span aria-hidden="true">↗</span></a></div>
  </section>

  <section id="ecosystem" class="shell section ecosystem-section">
    <div class="ecosystem-head"><div><div class="eyebrow">The Ecosystem</div><h2>One identity, connected work.</h2></div><a class="button secondary" href="https://hq.devina.id">View all at DevinaHQ <span aria-hidden="true">↗</span></a></div>
    <div class="ecosystem-links">
      <a href="https://hq.devina.id"><span>DevinaHQ</span><small>Projects, papers & ecosystem</small><b>↗</b></a>
      <a href="https://ols.devina.id"><span>OLS</span><small>Olympiad learning system</small><b>↗</b></a>
      <a href="https://github.com/DevinaAzaria"><span>GitHub</span><small>Source, labs & experiments</small><b>↗</b></a>
      <a href="/journal/"><span>Legacy & Archive</span><small>Selected historical writing</small><b>→</b></a>
    </div>
  </section>

  <section class="shell closing"><div class="eyebrow">A living portfolio</div><p>This site will grow as the work grows.</p><div class="actions"><a class="button" href="/journal/">Read the journal <span aria-hidden="true">→</span></a></div></section>
</BaseLayout>
