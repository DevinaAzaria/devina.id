---
import BaseLayout from '../../layouts/BaseLayout.astro';
import series from '../../../content/schedules/ai-thought-series.json';

const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Jakarta' }).format(new Date());
const publishedEssays = series.filter((essay) => essay.date <= today).reverse();
---
<BaseLayout title="Journal — Devina Azaria" description="Curated learning notes, current essays, and selected historical writing from Devina Azaria's portfolio archive.">
<section class="shell section page-intro">
  <div class="eyebrow">Journal</div>
  <h1>Learning in public, over time.</h1>
  <p class="lead">Current essays sit alongside selected historical writing and learning notes from the earlier version of devina.id. The AI Thought & Governance Series is published on a dated editorial roadmap so its development remains visible over time.</p>
</section>

<section class="shell section">
  <div class="grid journal-grid">
    {publishedEssays.map((essay, index) => (
      <article class:list={['card', index === 0 && 'feature-card']}>
        <div class="tag">Technology & Society · {essay.displayDate}</div>
        {index === 0 ? <h2>{essay.title}</h2> : <h3>{essay.title}</h3>}
        <p class="muted">{essay.description}</p>
        <a class="text-link" href={`/journal/${essay.slug}/`}>Read Essay →</a>
      </article>
    ))}
    <article class="card">
      <div class="tag">Learning Journey</div>
      <h3>Coding Journey</h3>
      <p class="muted">A curated timeline of coding and technology learning discovered in the legacy archive, beginning with early coding-interest articles and later learning-roadmap material.</p>
      <a class="text-link" href="/journal/coding-journey/">Open Coding Journey →</a>
    </article>
    <article class="card">
      <div class="tag">Technology Archive</div>
      <h3>AI & Digital Literacy</h3>
      <p class="muted">Current AI essays together with selected legacy writing on AI, digital services, privacy, and responsible technology use.</p>
      <a class="text-link" href="/journal/technology-literacy/">Open Technology Archive →</a>
    </article>
    <article class="card">
      <div class="tag">Culture & Creative</div>
      <h3>Culture, Music & Communication</h3>
      <p class="muted">A curated bridge between historical culture-related writing and the stronger evidence found in Devina's performances, recordings, and verified achievement records.</p>
      <a class="text-link" href="/journal/culture-communication/">Open Culture Archive →</a>
    </article>
  </div>
</section>

<section class="shell section archive-note">
  <div class="eyebrow">Editorial Principle</div>
  <h2>Timestamp the thinking, then let it evolve.</h2>
  <p class="lead">The series preserves when an idea was first framed and allows later essays to refine, challenge, or correct it. The goal is an intellectual trail rather than a claim of knowing the future in advance.</p>
</section>
</BaseLayout>
