---
import WritingLayout from './WritingLayout.astro';

const {
  title,
  description,
  published,
  modified = published,
  drafted = '26 Sep 2026',
  eyebrow = 'Journal · Technology & Society',
  authorName = null,
  authorUrl = '/about/',
  authorshipNote = 'Authorship & assistance: This essay was developed within Devina’s portfolio with editorial/technical assistance. Assistance is not presented as Devina’s independent work; authorship should only be attributed to Devina when explicitly marked.',
  image = null,
  imageAlt = null,
  imageWidth = null,
  imageHeight = null,
  structuredImages = image ? [image] : [],
} = Astro.props;
---
<WritingLayout
  title={title}
  description={description}
  published={published}
  modified={modified}
  section="Essays"
  eyebrow={eyebrow}
  authorName={authorName}
  authorUrl={authorUrl}
  authorshipNote={authorshipNote}
  image={image}
  imageAlt={imageAlt}
  imageWidth={imageWidth}
  imageHeight={imageHeight}
  structuredImages={structuredImages}
>
  <p slot="header-extra" class="draft-note">Concept drafted {drafted}. Publication is part of the AI Thought &amp; Governance Series.</p>
  <slot />
</WritingLayout>

<style>
  .draft-note{margin-top:.75rem;opacity:.65;font-size:.92rem}
</style>
